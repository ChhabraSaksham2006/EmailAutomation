# Database & Queue
MONGO_URI=mongodb://127.0.0.1:27017/cold-outreach
REDIS_URL=redis://127.0.0.1:6379

# Server & Auth
PORT=4000
JWT_SECRET=replace-with-strong-64-char-random-secret
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Security & Compliance
UNSUBSCRIBE_SIGNING_SECRET=replace-with-strong-hmac-secret-for-unsubscribe-links
SENDER_POSTAL_ADDRESS=Nehru Park, SCO 1, S D Market Model Town, Yamuna Nagar, Haryana 135001
ALERT_EMAIL=info@ramaconsultants.com

# Brevo HTTP API & Mailbox Configuration (Managed strictly via .env)
BREVO_API_KEY=xkeysib-replace-with-your-brevo-v3-api-key
BREVO_SENDER_EMAIL=info@ramaconsultants.com
BREVO_SENDER_NAME=Rama Consultants
BREVO_SENDER_TITLE=Consultant
BREVO_SENDER_COMPANY=Rama Consultants
BREVO_DAILY_CAP=35
BREVO_WEBHOOK_SECRET=

# Email Verification Provider (ZeroBounce / NeverBounce / Mock)
VERIFIER_PROVIDER=mock
VERIFIER_API_KEY=

# Worker Mode (set to true in local dev if running API + Worker in a single process or without Redis)
ENABLE_EMBEDDED_WORKER=true
